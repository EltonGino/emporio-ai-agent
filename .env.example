# Copy to .env and fill in. Never commit .env.

# LLM (any provider supported by langchain's init_chat_model; groq is the default)
LLM_PROVIDER=groq
# Groq production model with strong tool calling and PT-BR (see PROGRESS.md "Verified facts")
LLM_MODEL=openai/gpt-oss-120b
# Comma-separated, tried in order when the current model hits a rate limit (429)
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_API_KEY=
LLM_TEMPERATURE=0.2
# low | medium | high — reasoning tokens count against Groq rate limits
LLM_REASONING_EFFORT=low

# Multilingual fastembed model, 512-token window, no query/passage prefixes needed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

DATABASE_URL=sqlite:///data/runtime/store.db
CHECKPOINT_DB=data/runtime/checkpoints.db

# ISO datetime in the store timezone, e.g. 2026-03-25T10:30 (empty = real time)
AGENT_NOW=
DEMO_MODE=false

MAX_MESSAGES_PER_SESSION=15
# Customer messages per store-local day, across all sessions (protects the free LLM quota)
DAILY_MESSAGE_CAP=60
SESSION_RETENTION_DAYS=30
# History sent to the model: last N messages, further cut to fit the token budget
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_TOKENS=2500

# Optional LangSmith tracing (no code change needed)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
